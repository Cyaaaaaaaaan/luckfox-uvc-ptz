 #!/bin/sh
+#
+# Patch 0005: rklunch-disable-rkipc
+#
+# Changes:
+#   1. Kill rkipc unconditionally at startup and remove it from any init.d
+#      slot so it can never race with our UVC stack during boot.
+#
+#   2. Kill adbd at startup. ADB reconnection events generate USB bus resets
+#      which interrupt the UVC gadget transfer mid-stream, causing the host
+#      to see buffer errors. adbd is killed before usb_config.sh runs.
+#
+#   3. Watchdog loop in check_usb_state() simplified: it no longer tries to
+#      restart adbd. If rk_mpi_uvc dies it resets the UDC and restarts
+      the UVC stack cleanly without touching ADB.
+#
+#   4. The 2-second watchdog interval is retained. A /tmp/uvc_stop_check
+#      sentinel file still exits the loop cleanly.
+#
+#   5. rk_mpi_uvc is always started with -c /tmp/rkuvc.ini when the ini
+#      exists, and with -a /oem/usr/share/iqfiles when iqfiles exist.
+#      The iqfiles directory contains MIS5001 AIQ tuning files.
+#

+disable_rkipc()
+{
+    # Kill any running rkipc instance immediately
+    killall rkipc 2>/dev/null
+    killall -9 rkipc 2>/dev/null
+
+    # Remove rkipc from every init.d slot it might occupy
+    for f in /etc/init.d/S*rkipc /oem/etc/init.d/S*rkipc; do
+        [ -f "$f" ] && mv "$f" "${f}.disabled" && \
+            echo "Disabled: $f"
+    done
+
+    # Also disable the generic RkLunch that starts rkipc if it is not ours
+    if [ -f "/etc/init.d/S99RkLunch" ]; then
+        grep -q "rkipc" /etc/init.d/S99RkLunch && \
+            mv /etc/init.d/S99RkLunch /etc/init.d/S99RkLunch.disabled && \
+            echo "Disabled: /etc/init.d/S99RkLunch (contained rkipc)"
+    fi
+}
+
